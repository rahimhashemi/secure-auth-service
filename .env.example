# Copy to .env and fill with locally generated values. Never commit .env.
POSTGRES_PASSWORD=
APP_JWT_SECRET=
APP_REFRESH_PEPPER=
APP_API_DOCS_ENABLED=true
APP_TRUSTED_PROXIES=

APP_RATE_LIMIT_ACCOUNT_KEY=

# Independent AES-256 outbox key: openssl rand -hex 32
APP_MAIL_OUTBOX_KEY=
APP_VERIFICATION_PUBLIC_URL=http://localhost:8081/verify-email.html
APP_MAIL_FROM=no-reply@example.invalid

# Independent secrets for TOTP encryption and recovery-code hashing.
APP_MFA_ENCRYPTION_KEY=
APP_MFA_RECOVERY_PEPPER=

# Optional session reauthentication window (60–3600 seconds).
APP_STEP_UP_TTL_SECONDS=300
